{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "720px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"palette": [
				{ "slug": "base", "name": "Fond", "color": "#FFFFFF" },
				{ "slug": "contrast", "name": "Texte", "color": "#1A1A1A" },
				{ "slug": "primary", "name": "Principale", "color": "#3D3D3D" },
				{ "slug": "secondary", "name": "Secondaire", "color": "#7A7A7A" },
				{ "slug": "accent", "name": "Accent", "color": "#E5E5E5" }
			]
		},
		"typography": {
			"fluid": true,
			"defaultFontSizes": false,
			"fontFamilies": [
				{
					"slug": "body",
					"name": "Texte",
					"fontFamily": "system-ui, -apple-system, \"Segoe UI\", Roboto, sans-serif"
				},
				{
					"slug": "heading",
					"name": "Titres",
					"fontFamily": "Georgia, \"Times New Roman\", serif"
				}
			],
			"fontSizes": [
				{ "slug": "small", "name": "Petit", "size": "0.875rem", "fluid": false },
				{ "slug": "medium", "name": "Moyen", "size": "1rem", "fluid": false },
				{ "slug": "large", "name": "Grand", "size": "1.5rem", "fluid": { "min": "1.25rem", "max": "1.5rem" } },
				{ "slug": "x-large", "name": "Très grand", "size": "2.5rem", "fluid": { "min": "1.75rem", "max": "2.5rem" } },
				{ "slug": "xx-large", "name": "Énorme", "size": "3.5rem", "fluid": { "min": "2.25rem", "max": "3.5rem" } }
			]
		},
		"spacing": {
			"units": ["px", "rem", "%", "vw", "vh"]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--contrast)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"lineHeight": "1.6"
		},
		"spacing": {
			"blockGap": "1.5rem",
			"padding": {
				"left": "var(--wp--preset--spacing--50)",
				"right": "var(--wp--preset--spacing--50)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"lineHeight": "1.2"
				}
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--x-large)" } },
			"h3": { "typography": { "fontSize": "var(--wp--preset--font-size--large)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--primary)" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"button": {
				"color": {
					"background": "var(--wp--preset--color--primary)",
					"text": "var(--wp--preset--color--base)"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--contrast)"
					}
				}
			}
		}
	},
	"customTemplates": [
		{ "name": "page-no-title", "title": "Page sans titre", "postTypes": ["page"] }
	],
	"templateParts": [
		{ "name": "header", "title": "En-tête", "area": "header" },
		{ "name": "footer", "title": "Pied de page", "area": "footer" }
	]
}
